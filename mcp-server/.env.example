# Port this MCP server listens on
MCP_PORT=3034

# PingAuthorize
PAZ_BASE_URL=https://localhost:9443
PAZ_BRANCH=<your-paz-branch-uuid>
PAZ_USER_ID=admin

# Advanced Identity Cloud (AIC)
AIC_HOST=<your-tenant>.forgeblocks.com
AIC_SERVICE_ACCOUNT_ID=<your-service-account-uuid>
# AIC_JWK — JWK JSON as a string (preferred for Vercel/cloud deployments)
# AIC_JWK={"kty":"RSA","n":"...","e":"...","d":"..."}
# AIC_JWK_PATH — path to JWK file (used only if AIC_JWK is not set; for local dev)
AIC_JWK_PATH=../dashboard/backend/privateKey.jwk
AIC_REALM=/realms/root/realms/alpha
AIC_SCOPES=fr:am:* fr:idm:*

# PingGateway route manager — GitHub Contents API
GITHUB_OWNER=<your-github-org-or-user>
GITHUB_REPO=<your-gateway-config-repo>
GITHUB_PATH=config/routes
GITHUB_REF=main
GITHUB_TOKEN=<your-github-pat>
