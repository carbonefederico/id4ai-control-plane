# AIC tenant hostname — no protocol, no trailing slash
AIC_HOST=<your-tenant>.forgeblocks.com

# Service account UUID (from the AIC admin console)
SERVICE_ACCOUNT_ID=<your-service-account-uuid>

# Service account private key in JWK format (JSON string)
AIC_JWK={"kty":"RSA","n":"...","e":"...","d":"..."}

# AM realm path (default: alpha)
REALM=/realms/root/realms/alpha

# Scopes to request (space-separated)
# fr:am:*   — AM config REST APIs (creates a CTS session; limit 5 concurrent)
# fr:idm:*  — IDM managed object APIs (no session quota)
SCOPES=fr:am:* fr:idm:*
